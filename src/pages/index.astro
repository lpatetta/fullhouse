---
import videoLinks from '../data/videos.json';
import events from '../data/events.json';
import links from '../data/links.json';

const MONTHS = ['JAN', 'FEV', 'MAR', 'ABR', 'MAI', 'JUN', 'JUL', 'AGO', 'SET', 'OUT', 'NOV', 'DEZ'];
const MONTHS_LONG = ['JANEIRO', 'FEVEREIRO', 'MARÇO', 'ABRIL', 'MAIO', 'JUNHO', 'JULHO', 'AGOSTO', 'SETEMBRO', 'OUTUBRO', 'NOVEMBRO', 'DEZEMBRO'];
const WEEKDAYS = ['DOMINGO', 'SEGUNDA', 'TERÇA', 'QUARTA', 'QUINTA', 'SEXTA', 'SÁBADO'];
// e.g. "2026-10-31" → "SÁBADO 31 DE OUTUBRO"
const longDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  const weekday = WEEKDAYS[new Date(Date.UTC(y, m - 1, d)).getUTCDay()];
  return `${weekday} ${d} DE ${MONTHS_LONG[m - 1]}`;
};
const fmt = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return { day: d, month: MONTHS[Number(m) - 1], year: y };
};

// Evaluated at build time. Upcoming soonest first; past most recent first.
// `image` and `tickets` are optional (past events often have neither).
type Event = { date: string; time: string; name: string; venue: string; address: string; image?: string; tickets?: string; featured?: boolean };
const today = new Date().toISOString().slice(0, 10);
const upcoming = (events as Event[])
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));
const past = (events as Event[])
  .filter((e) => e.date < today)
  .sort((a, b) => b.date.localeCompare(a.date));
const featured = upcoming.find((e) => e.featured) ?? upcoming[0];

const listen = links.listen.filter((l) => l.url);
const follow = links.follow.filter((l) => l.url);
const handle = (h: string) => h.replace(/^@/, '');

// videos.json holds full YouTube URLs; derive the video ID at build time.
// Supports watch?v=, youtu.be/, shorts/, embed/ and live/ links. Empty or REPLACE* URLs stay placeholders.
const youtubeId = (url: string) => {
  if (!url || url.startsWith('REPLACE')) return '';
  const m = url.match(/(?:[?&]v=|youtu\.be\/|\/(?:shorts|embed|live)\/)([A-Za-z0-9_-]{11})/);
  if (!m) throw new Error(`videos.json: could not find a YouTube video ID in "${url}"`);
  return m[1];
};
const videos = videoLinks.map((v) => ({ id: youtubeId(v.url), title: v.title }));
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Full House Label — Rio de Janeiro</title>
  <meta name="description" content="Full House Label: gravadora e plataforma de música eletrônica do Rio de Janeiro. Lançamentos, sets, podcasts e eventos." />
  <meta property="og:title" content="Full House Label" />
  <meta property="og:image" content={featured?.image ?? '/images/halloween-2026.webp'} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Bricolage+Grotesque:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="nav wrap" aria-label="Principal">
    <a href="#top" class="logo">FULL HOUSE LABEL</a>
    <div class="nav-links">
      <a href="#assistir">ASSISTIR</a>
      <a href="#ouvir">OUVIR</a>
      <a href="#seguir">SEGUIR</a>
      <a href="#eventos">EVENTOS</a>
    </div>
  </nav>

  <main id="top">
    {featured && (
      <section class="hero wrap">
        <div class="hero-text">
          <p class="kicker">{longDate(featured.date)}</p>
          <h1>{featured.name}</h1>
          <p class="hero-sub">{featured.venue}<br />{featured.address}</p>
          <div class="btns">
            {featured.tickets && <a class="btn btn-solid" href={featured.tickets} target="_blank" rel="noopener">INGRESSOS</a>}
            <a class="btn btn-line" href="#eventos">TODAS AS DATAS</a>
          </div>
        </div>
        {featured.image && <img class="hero-img" src={featured.image} alt={`Flyer: ${featured.name}, ${featured.venue}`} width="1440" height="1800" />}
      </section>
    )}

    <section id="assistir" class="videos">
      <div class="wrap">
        <div class="featured-video" id="featured-video" aria-live="polite"></div>
        <div class="thumbs" id="thumbs"></div>
        <p class="more"><a href="https://www.youtube.com/@fullhouselabelrj" target="_blank" rel="noopener">VER CANAL NO YOUTUBE →</a></p>
      </div>
    </section>

    <section id="ouvir" class="links wrap">
      <h2>OUVIR</h2>
      <div class="pills">
        {listen.map((l) => <a class="pill" href={l.url} target="_blank" rel="noopener">{l.name.toUpperCase()}</a>)}
      </div>
    </section>

    <section id="seguir" class="links wrap">
      <h2>SEGUIR</h2>
      <div class="pills">
        {follow.map((l, i) => <a class={i === 0 ? 'pill pill-solid' : 'pill'} href={l.url} target="_blank" rel="noopener">{l.name.toUpperCase()}</a>)}
      </div>
      {links.crew.length > 0 && (
        <>
          <p class="kicker muted">A FAMÍLIA FULL HOUSE</p>
          <div class="crew">
            {links.crew.map((h) => (
              <a href={`https://www.instagram.com/${handle(h)}/`} target="_blank" rel="noopener">@{handle(h)}</a>
            ))}
          </div>
        </>
      )}
    </section>

    <section id="eventos" class="events wrap">
      <h2>EVENTOS</h2>
      {upcoming.length === 0 && (
        <p class="muted center">Novas datas em breve. Siga <a href="https://www.instagram.com/fullhouselabel/">@fullhouselabel</a>.</p>
      )}
      {upcoming.length + past.length > 0 && (
        <ul>
          {upcoming.map((e) => (
            <li>
              <span class="ev-date">{fmt(e.date).day} {fmt(e.date).month}</span>
              <span class="ev-name">{e.name}</span>
              <span class="ev-place">{e.venue} · {e.time}</span>
              {e.tickets ? <a class="btn btn-line-accent" href={e.tickets} target="_blank" rel="noopener">INGRESSOS</a> : <span />}
            </li>
          ))}
          {past.map((e) => (
            <li class="ev-past">
              <span class="ev-date">{fmt(e.date).day} {fmt(e.date).month}</span>
              <span class="ev-name">{e.name}</span>
              <span class="ev-place">{e.venue} · {e.time}</span>
              <span class="ev-status">JÁ ROLOU</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>

  <footer>
    <div class="wrap foot">
      <span>© {new Date().getFullYear()} FULL HOUSE LABEL · RIO DE JANEIRO</span>
      <a href={`mailto:${links.email}`}>{links.email.toUpperCase()}</a>
    </div>
  </footer>

  <script type="application/json" id="videos-data" set:html={JSON.stringify(videos)}></script>
  <script>
    type Video = { id: string; title: string };
    const videos: Video[] = JSON.parse(document.getElementById('videos-data')!.textContent || '[]');
    const featuredEl = document.getElementById('featured-video')!;
    const thumbsEl = document.getElementById('thumbs')!;
    const isPlaceholder = (v: Video) => !v.id || v.id.startsWith('REPLACE');

    function renderFeatured(v: Video) {
      featuredEl.innerHTML = '';
      if (isPlaceholder(v)) {
        const box = document.createElement('div');
        box.className = 'placeholder';
        box.textContent = `${v.title} — adicione o ID do vídeo em src/data/videos.json`;
        featuredEl.appendChild(box);
        return;
      }
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${v.id}?rel=0`;
      iframe.title = v.title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      featuredEl.appendChild(iframe);
    }

    function renderThumbs(current: number) {
      thumbsEl.innerHTML = '';
      videos.forEach((v, i) => {
        if (i === current) return;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'thumb';
        btn.setAttribute('aria-label', `Assistir: ${v.title}`);
        if (isPlaceholder(v)) {
          const ph = document.createElement('div');
          ph.className = 'placeholder small';
          ph.textContent = v.title;
          btn.appendChild(ph);
        } else {
          const img = document.createElement('img');
          img.src = `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`;
          img.alt = '';
          img.loading = 'lazy';
          btn.appendChild(img);
        }
        const cap = document.createElement('span');
        cap.className = 'thumb-title';
        cap.textContent = v.title;
        btn.appendChild(cap);
        btn.addEventListener('click', () => {
          show(i);
          featuredEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        thumbsEl.appendChild(btn);
      });
    }

    function show(i: number) {
      renderFeatured(videos[i]);
      renderThumbs(i);
    }

    if (videos.length) show(Math.floor(Math.random() * videos.length));
  </script>

  <style is:global>
    :root {
      --bg: #0b0b0c;
      --panel: #18181a;
      --line: #333336;
      --text: #f2eee6;
      --muted: #a8a49c;
      --accent: #b8ff3c;   /* neon green from the flyer */
      --hot: #ff4a1c;      /* Halloween orange-red */
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: 'Bricolage Grotesque', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--text); text-decoration: none; }
    a:hover { color: var(--accent); }
    h1, h2 { font-family: 'Anton', Impact, sans-serif; font-weight: 400; margin: 0; line-height: 0.95; }
    .wrap { max-width: 1280px; margin: 0 auto; padding: 0 40px; }
    .muted { color: var(--muted); }
    .center { text-align: center; }
    .kicker { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.3em; color: var(--accent); }
    .kicker.muted { color: var(--muted); margin-top: 16px; }

    .nav { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding-top: 28px; padding-bottom: 28px; }
    .logo { font-family: 'Anton', Impact, sans-serif; font-size: 26px; letter-spacing: 0.04em; }
    .nav-links { display: flex; flex-wrap: wrap; gap: 28px; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; }

    .hero { display: flex; flex-wrap: wrap-reverse; align-items: center; gap: 56px; padding-top: 32px; padding-bottom: 96px; }
    .hero-text { flex: 1 1 380px; display: flex; flex-direction: column; gap: 24px; }
    .hero h1 { font-size: clamp(52px, 7vw, 104px); }
    .hero-sub { margin: 0; font-size: 18px; line-height: 1.5; color: #d6d2ca; }
    .hero-img { flex: 1 1 420px; width: 100%; max-width: 560px; height: auto; display: block; box-shadow: 0 30px 80px rgba(184, 255, 60, 0.12); }

    .btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
    .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 28px; font-size: 14px; font-weight: 700; letter-spacing: 0.14em; }
    .btn-solid { background: var(--accent); color: var(--bg); }
    .btn-solid:hover { background: var(--text); color: var(--bg); }
    .btn-line { border: 1px solid var(--text); }
    .btn-line-accent { border: 1px solid var(--accent); color: var(--accent); }
    .btn-line-accent:hover { background: var(--accent); color: var(--bg); }

    .videos { padding-bottom: 112px; }
    .featured-video { width: 100%; aspect-ratio: 16 / 9; max-height: 90vh; background: #000; }
    .featured-video iframe { width: 100%; height: 100%; border: 0; display: block; }
    .placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 24px; background: var(--panel); border: 1px dashed #55555a; color: #8a8a90; font-size: 14px; letter-spacing: 0.06em; }
    .placeholder.small { aspect-ratio: 16 / 9; height: auto; font-size: 12px; }
    .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 32px; }
    @media (max-width: 900px) { .thumbs { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 520px) { .thumbs { grid-template-columns: 1fr; } }
    .thumb { all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 10px; }
    .thumb img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; transition: opacity .2s; }
    .thumb:hover img, .thumb:focus-visible img { opacity: 0.75; }
    .thumb:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
    .thumb-title { font-size: 15px; font-weight: 700; }
    .more { text-align: center; margin: 40px 0 0; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; }

    .links { display: flex; flex-direction: column; align-items: center; gap: 28px; text-align: center; padding-bottom: 88px; }
    .links h2 { font-size: 56px; }
    .pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
    .pill { display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; border: 1px solid #44444a; font-size: 14px; font-weight: 700; letter-spacing: 0.14em; }
    .pill-solid { background: var(--accent); color: var(--bg); border-color: var(--accent); }
    .pill-solid:hover { color: var(--bg); background: var(--text); }
    .crew { display: flex; flex-direction: column; align-items: center; gap: 12px; }
    .crew a { font-size: 16px; font-weight: 500; padding: 4px 0; }
    .crew a:hover, .crew a:focus-visible { color: var(--accent); }

    .events { padding-bottom: 96px; }
    .events h2 { font-size: 56px; text-align: center; margin-bottom: 32px; }
    .events ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .events li { display: grid; grid-template-columns: 140px 1fr 1fr auto; gap: 16px; align-items: center; padding: 24px 0; border-bottom: 1px solid var(--line); }
    .ev-date { font-family: 'Anton', Impact, sans-serif; font-size: 28px; }
    .ev-name { font-size: 18px; font-weight: 700; }
    .ev-place { color: var(--muted); }
    .ev-past { opacity: 0.55; }
    .ev-status { font-size: 13px; font-weight: 700; letter-spacing: 0.16em; color: var(--muted); }

    footer { border-top: 1px solid #222225; }
    .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding-top: 32px; padding-bottom: 32px; font-size: 13px; letter-spacing: 0.14em; color: var(--muted); }
    .foot a { color: var(--muted); }

    @media (max-width: 720px) {
      /* Side gutters only: a `padding` shorthand here would wipe the vertical padding of every .wrap section. */
      .wrap { padding-left: 16px; padding-right: 16px; }
      .nav { padding-top: 20px; padding-bottom: 20px; }
      .hero { gap: 32px; padding-top: 8px; padding-bottom: 64px; }
      .videos { padding-bottom: 72px; }
      .links { gap: 24px; padding-bottom: 64px; }
      .links h2, .events h2 { font-size: 48px; }
      .events { padding-bottom: 64px; }
      .events h2 { margin-bottom: 24px; }
      .events li { padding: 20px 0; }
      .foot { padding-top: 24px; padding-bottom: 24px; }
      .events li { grid-template-columns: 1fr; gap: 6px; }
      .events li .btn { justify-self: start; margin-top: 8px; }
    }
  </style>
</body>
</html>
